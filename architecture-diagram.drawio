        <!-- ================================================================ -->
        <!-- ===== 實驗設計 Phase 1–6 ===== -->
        <!-- ================================================================ -->
        <mxCell id="ph_group" value="驗證實驗設計（Phase 1–6）— 在 VS Code 環境逐步執行" style="swimlane;startSize=36;fillColor=#f0f0f0;strokeColor=#444444;fontStyle=1;fontSize=13;rounded=1;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1360" width="1440" height="310" as="geometry" />
        </mxCell>

        <!-- Phase 1 -->
        <mxCell id="ph1" value="&lt;b&gt;Phase 1&lt;/b&gt;&lt;br/&gt;修正腳本 bug&lt;br/&gt;建立 S_attr-only 基準&lt;br/&gt;（15 組輸入植株）&lt;br/&gt;&lt;br/&gt;成本：$0&lt;br/&gt;時間：10–20 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="ph_group">
          <mxGeometry x="20" y="50" width="190" height="220" as="geometry" />
        </mxCell>

        <!-- Phase 2 -->
        <mxCell id="ph2" value="&lt;b&gt;Phase 2 ★ 核心&lt;/b&gt;&lt;br/&gt;全量 S_attr vs S_llm&lt;br/&gt;≈100–110 組配對&lt;br/&gt;Spearman ρ（n=15）&lt;br/&gt;&lt;br/&gt;成本：$0.20–0.33&lt;br/&gt;時間：30–60 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="ph_group">
          <mxGeometry x="232" y="50" width="190" height="220" as="geometry" />
        </mxCell>

        <!-- Phase 3 -->
        <mxCell id="ph3" value="&lt;b&gt;Phase 3&lt;/b&gt;&lt;br/&gt;S_llm 一致性&lt;br/&gt;5 組 × 前 3 名&lt;br/&gt;--repeat 3&lt;br/&gt;通過：SD ≤ 15&lt;br/&gt;&lt;br/&gt;成本：$0.11&lt;br/&gt;時間：10–20 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ph_group">
          <mxGeometry x="444" y="50" width="190" height="220" as="geometry" />
        </mxCell>

        <!-- Phase 4 -->
        <mxCell id="ph4" value="&lt;b&gt;Phase 4&lt;/b&gt;&lt;br/&gt;權重校準（NNLS）&lt;br/&gt;+ held-out 驗證&lt;br/&gt;校準集 10 組&lt;br/&gt;測試集 5 組&lt;br/&gt;&lt;br/&gt;成本：$0（重用）&lt;br/&gt;時間：20–30 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="ph_group">
