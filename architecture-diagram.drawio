        <mxCell id="val_longterm" value="&lt;b&gt;中長期路線&lt;/b&gt;&lt;br/&gt;S_cnn（CLIP 影像嵌入）&lt;br/&gt;→ 資料庫 ≥ 200 種後引入&lt;br/&gt;→ 三方驗證：S_attr / S_cnn / S_llm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=11;" vertex="1" parent="val">
          <mxGeometry x="695" y="285" width="300" height="115" as="geometry" />
