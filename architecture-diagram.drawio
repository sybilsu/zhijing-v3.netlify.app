          <mxGeometry x="15" y="230" width="280" height="42" as="geometry" />
        </mxCell>
        <mxCell id="val_sa_ornament" value="觀賞期 Jaccard（FLW SEASON + STRUCT INT）&lt;br/&gt;&lt;b&gt;× 5 分&lt;/b&gt;（色彩刻意排除）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="val_sattr">
          <mxGeometry x="15" y="284" width="280" height="44" as="geometry" />
        </mxCell>

        <!-- S_llm box -->
        <mxCell id="val_sllm" value="&lt;b&gt;S_llm（VLM-as-Judge）&lt;/b&gt;&lt;br/&gt;Claude Haiku 4.5 Vision&lt;br/&gt;&lt;br/&gt;對每組「參考圖裁切 × 候選植物照片」&lt;br/&gt;給出 0–100 分視覺相似度&lt;br/&gt;&lt;br/&gt;用途：作為 S_attr 排名的外部效標&lt;br/&gt;scripts/validate-similarity.mjs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="val">
          <mxGeometry x="365" y="45" width="290" height="220" as="geometry" />
        </mxCell>

        <!-- Spearman compare box -->
        <mxCell id="val_compare" value="&lt;b&gt;驗證比較指標&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Spearman ρ(S_attr, S_llm)&lt;br/&gt;　最低門檻：ρ ≥ 0.6（中度相關）&lt;br/&gt;　&lt;b&gt;目標值：ρ ≥ 0.7（強相關）&lt;/b&gt;&lt;br/&gt;　文獻基準：VLM-as-Judge ρ = 0.73–0.84&lt;br/&gt;&lt;br/&gt;Overlap@5（參考指標）&lt;br/&gt;S_llm 一致性 SD ≤ 15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="val">
          <mxGeometry x="695" y="45" width="300" height="220" as="geometry" />
        </mxCell>

        <!-- Decision box -->
        <mxCell id="val_decision" value="&lt;b&gt;驗證後決策&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A：ρ ≥ 0.7 → 不動 WEIGHTS&lt;br/&gt;B：Phase 4 校準提升 →&lt;br/&gt;　更新 matching.js WEIGHTS&lt;br/&gt;C1：Role 有意義提升 →&lt;br/&gt;　雷達圖 5 軸 → 6 軸&lt;br/&gt;C2：Role 無提升 →&lt;br/&gt;　結構角色 badge（UI 標籤）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="val">
          <mxGeometry x="1040" y="45" width="275" height="220" as="geometry" />
        </mxCell>

        <!-- Role 探索 note -->
